@model IEnumerable<zuroWa.Core.Domain.EyeMax.TmdbMovie>

@{
    ViewBag.Title = "Search result for " + ViewBag.Query;
    Layout = "_Layout";
}

<div class="container headerTitle text-center">
    <h1>Result for "@ViewBag.Query"</h1>
</div>

@if (!Model.Any())
{
    <div class="description-box pixel-border2">
        No movies found for "@ViewBag.Query" <br/>
        Try a different title or check your spelling
    </div>
}
else
{
    foreach (var (item, i) in Model.Select((m, idx) => (m, idx)))
    {
        string poster;
        
        if (item.PosterPath != null)
        {
            poster = "https://image.tmdb.org/t/p/w92" + item.PosterPath;
        }
        else
        {
            poster = Url.Content("~/images/no-image.png");
        }
    
        <div class="movie-row pixel-border2" style="--delayVariable:@i">
            <div class="pixel-border">
                <img alt="@item.Title poster" src="@poster" onerror="this.onerror=null; this.src ='@Url.Content("~/images/no-image.png")'">
            </div>
            <div class="col-title">
                @item.Title
            </div>
            <div class="col-date">
                @(string.IsNullOrWhiteSpace(item.ReleaseDate) || item.ReleaseDate.Length <= 4 ? "Unknown" : item.ReleaseDate.Substring(0, 4))
            </div>
            <div class="col-desc">
                @(item.Overview?.Length > 150 ? item.Overview.Substring(0, 150) + "…" : item.Overview ?? "No description available")
            </div>
            <form asp-action="Add" asp-controller="Favorites" method="post">
                <input type="hidden" name="tmdbId" value="@item.TmdbId" />
                <input type="hidden" name="title" value="@item.Title" />
                <input type="hidden" name="posterPath" value="@item.PosterPath" />
                <button type="submit" class="btn-movie-add">
                    Add to ♡ 
                </button>
            </form>
        </div>
    }
}
