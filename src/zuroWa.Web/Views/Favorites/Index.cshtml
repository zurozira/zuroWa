@using System.Security.Claims

@model IEnumerable<zuroWa.Core.Domain.EyeMax.Movie>

@{
    ViewBag.Title = "Favorite movies";
    Layout = "_Layout";
}

<div class="headerTitle text-center">
    <h1>Favorite list</h1>
</div>

<div class="description-box pixel-border2 slideIn1">
    All users favorite movies will be shown here, maybe I'll like your movies :)
</div>

@if (!Model.Any())
{
    <div class="movie-row pixel-border2">
        Favorite list is currently empty
    </div>
}
else
{
    foreach (var (item, i) in Model.Select((m, idx) => (m, idx)))
    {
        string poster;
        
        // I defined PosterPath as non-nullable in Movie.cs, so item.PosterPath != null is always true
        // This is the correct check:
        if (!string.IsNullOrEmpty(item.PosterPath))
        {
            poster = "https://image.tmdb.org/t/p/w92" + item.PosterPath;
        }
        else
        {
            poster = Url.Content("~/Images/no-image.png");
        }
        
        <div class="favorite-row">
            <div class="movie-row pixel-border2" style="--delayVariable:@i">
                <div class="pixel-border text-center">
                    <img alt="@item.Title poster" src="@poster" onerror="this.onerror=null; this.src ='@Url.Content("~/Images/no-image.png")'">
                </div>
                <div class="col-title">
                    @item.Title
                </div>
                <div class="col-date">
                    @item.AddedAt.ToString("MMM dd, yyyy")
                </div>
                <div class="col-desc">
                    @(item.MyComment?.Length > 150 ? item.MyComment.Substring(0, 150) + "…" : item.MyComment ?? "No comment available")
                </div>
                <div class="col-date">
                    @item.SavedBy
                </div>
            
                @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == item.UserId)
                {
                    <form asp-action="Remove" asp-controller="Favorites" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn-favorite-remove">Remove</button>
                    </form>
                }
                else
                {
                    <button class="btn-favorite-remove" disabled>No Access</button>
                }
            </div>
        </div>
    }
}