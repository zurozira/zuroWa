@model IEnumerable<COMP266EyeMaxCinemas.Models.MovieViewModel>

@{
    ViewData["Title"] = "Now Playing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="headerTitle text-center">
    <img alt="nowPlaying" style="width: 200px;" src="https://w1theredsoul.neocities.org/images/nowplaying-ezgif.com-gif-maker.gif">
</div>

@{var i = 0;}
@foreach (var item in Model) {
    
    <div class="movie-row pixel-border2" style="--delayVariable:@i">
        <div class="pixel-border">
            <img alt="" src="@(item.PosterPath.StartsWith("~/") ? Url.Content(item.PosterPath) : item.PosterPath)">
        </div>
        <div class="col-title">
            @item.Title
        </div>
        <div class="col-director">
            @item.Director
        </div>
        <div class="col-date">
            @Html.DisplayFor(modelItem => item.DateReleased)
        </div>
        <div class="col-desc">
            @item.Description
        </div>
        <div class="col-actions">
            @Html.ActionLink("Details", "Details", new {  id=item.Id  }, new { @class="Pbutton-details"})
        </div>
    </div>
    i++;
}