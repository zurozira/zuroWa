@model COMP266EyeMaxCinemas.Models.MovieViewModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container detail-container">
    <div>
        <div class="pixel-border slideIn1">
            <img alt="" src="@(Model.PosterPath.StartsWith("~/") ? Url.Content(Model.PosterPath) : Model.PosterPath)">
        </div>
    </div>
    <div class="detail-info fadeIn1">
        <div class="detail-title">
            @Html.DisplayFor(model => model.Title)
        </div>
        <div class="detail-director">
            @Html.DisplayFor(model => model.Director)
        </div>
        <div class="detail-date">
            @Html.DisplayFor(model => model.DateReleased)
        </div>
        <div class="detail-genre">
            @Html.DisplayFor(model => model.Genre)
        </div>
        <div class="detail-description">
            @Html.DisplayFor(model => model.Description)
        </div>
    </div>
</div>
